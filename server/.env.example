NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Public URL of this API — used in doctors' calendar-sync (ICS) links that Google/Outlook fetch.
PUBLIC_API_URL=

# MySQL (open it in MySQL Workbench). Tables are created automatically on first start;
# database/schema.sql has the same structure if you prefer to create them yourself.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=clinicsaathi
# Set to "disabled" to run the API without background jobs (reminders, recall, campaigns).
REDIS_URL=redis://localhost:6379

# Long random strings, different from each other. Never commit real values.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Signs 5-minute file download links. Defaults to JWT_ACCESS_SECRET if unset.
FILE_URL_SECRET=change-me-file-secret
# Private, non-public directory for lab reports and patient documents.
STORAGE_DIR=storage/private

# Super admin provisioning (used only by `npm run seed`).
SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=   # leave unset to generate a one-time password

# ---- Integrations — leave blank to run in stub mode (messages are logged, payments refused)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Meta app secret: verifies X-Hub-Signature-256 on inbound webhooks (required in production).
WHATSAPP_APP_SECRET=
# Dev only: route inbound WhatsApp from an unmapped number to this clinic slug.
WHATSAPP_DEV_CLINIC_SLUG=

OPENAI_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM=

# Predefined super admin login (created on first server start; there is no public sign-up).
SUPER_ADMIN_EMAIL=admin@clinicsaathi.com
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_NAME=Super Admin

# Optional: Stripe for international cards (Razorpay handles UPI/cards/net banking).
STRIPE_SECRET_KEY=
